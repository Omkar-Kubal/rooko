# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local tooling, build logs, and captured device output
/.tmp/
/tmp/
/output/
/.openai/
/archive/
/sites/
/*.log
/device-*.png

# Keep written research findings without publishing third-party APKs or decompiled code.
/analysis/**
!/analysis/**/
!/analysis/**/*.md

# Keep QA notes without publishing device screenshots, recordings, or UI dumps.
/docs/qa/**
!/docs/qa/**/
!/docs/qa/**/*.md

# Local reference video; its approved design decisions are recorded in AGENTS.md.
/onboarding.mp4

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
